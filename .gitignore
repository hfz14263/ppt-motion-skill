# Python bytecode. `import`ing the skill's modules writes these next to the source,
# and they are build residue, not source.
__pycache__/
*.py[cod]

# The skill's own working directories. Rendered decks, per-shape preview layers and
# review PNGs are outputs, not part of the tool.
**/preview/
**/review/
*.com.pptx

# Calibration artifacts: make_calibration.ps1 rebuilds these on demand, and the
# analyser's own report lands in tests/calib/analysis/.
tests/calib/*.mp4
tests/calib/*.pptx
tests/calib/analysis/
tests/calib/.office-tmp/
probe-createvideo/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
